    "positronActionBar.border": "#444444",
    "positronActionBar.hoverBackground": "#80808022"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#A6A6A6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#F1B300",
        "fontStyle": ""
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#F1B300",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFD479",
        "fontStyle": ""
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F1B300",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#D9C697",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#F1B300",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#F1B300",
        "fontStyle": ""
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#A6A6A6",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#FFFFFF",
    "parameter": "#FFFFFF",
    "property": "#FFFFFF",
    "function": {
      "foreground": "#FFFFFF",
      "bold": true
    },
    "method": {
      "foreground": "#FFFFFF",
      "bold": true
    },
    "type": "#D9C697",
    "class": "#D9C697",
    "number": "#FFD479",
    "string": "#F1B300",
    "keyword": {
      "foreground": "#F1B300",
      "bold": true
    },
    "comment": {
      "foreground": "#A6A6A6",
      "italic": true
    }
  }
}
