  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#666666",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#795900",
        "fontStyle": ""
      }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#795900",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#191919",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#795900",
        "fontStyle": ""
      }
    },
    {
      "scope": "entity.name.function",
      "settings": {
        "foreground": "#191919",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#795900",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#62502B",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#795900",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#795900",
        "fontStyle": ""
      }
    },
    {
      "scope": "punctuation",
      "settings": {
        "foreground": "#666666",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#191919",
    "parameter": "#191919",
    "property": "#191919",
    "function": {
      "foreground": "#191919",
      "bold": true
    },
    "method": {
      "foreground": "#191919",
      "bold": true
    },
    "type": "#62502B",
    "class": "#62502B",
    "number": "#795900",
    "string": "#795900",
    "keyword": {
      "foreground": "#795900",
      "bold": true
    },
    "comment": {
      "foreground": "#666666",
      "italic": true
    }
  }
}
